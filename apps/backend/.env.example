# Supabase (cp 전용 신규 프로젝트)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# 카드뉴스 배경 AI 이미지 생성 모드.
#   stub   : 고정 sample PNG 반환 (cost $0, 플럼빙 검증용 — 토픽 무시)
#   openai : gpt-image-1, 1024×1024 medium quality (~$0.042/장)
IMAGE_GEN_MODE=openai

# n8n 발행 webhook (Phase 8). 워커가 pending job 을 이 URL 로 HMAC 서명해 트리거.
# HMAC_WEBHOOK_SECRET 은 n8n 콜백(/api/webhook/publish-result) 검증에도 양방향 공유.
N8N_WEBHOOK_URL=https://n8n.dawoon.dev/webhook/publish
HMAC_WEBHOOK_SECRET=

# CORS
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
