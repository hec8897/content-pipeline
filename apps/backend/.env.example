# Supabase (cp 전용 신규 프로젝트)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GEMINI_API_KEY=

# Phase 6 — 카드뉴스 cover/outro 배경 AI 이미지 생성 모드.
#   stub         : 고정 sample PNG 반환 (cost $0, 플럼빙 검증용 — 토픽 무시)
#   pollinations : 무료 community Flux endpoint, 키/가입 없음, 토픽 반영됨 (5~30s)
#   gemini       : 나노바나나 — Google AI Studio 결제 활성 필요 (free tier 미지원)
IMAGE_GEN_MODE=stub

# CORS
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
