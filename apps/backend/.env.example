# Supabase (cp 전용 신규 프로젝트)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# 카드뉴스 배경 AI 이미지 생성 모드.
#   stub   : 고정 sample PNG 반환 (cost $0, 플럼빙 검증용 — 토픽 무시)
#   openai : gpt-image-1, 1024×1024 medium quality (~$0.042/장)
IMAGE_GEN_MODE=openai

# CORS
FRONTEND_URL=http://localhost:3000

# Server
PORT=3001
