# 빌드 context 에서 제외할 파일들.
# Dockerfile 은 repo root 에서 실행 (`docker build -f apps/backend/Dockerfile .`) 이라
# repo root 기준 경로.

# 어디서나 무시할 큰 폴더 / 파일
**/node_modules
**/dist
**/.next
**/.turbo
**/coverage
**/.git

# 환경 시크릿 (image 에 절대 들어가면 안 됨)
**/.env
**/.env.*
!**/.env*.example

# 로컬 / IDE / OS
**/.DS_Store
**/*.log
**/.vscode
**/.cursor
**/.claude

# 본 phase 와 무관한 디렉토리 (image 부피 감소)
docs
.github
infra
supabase

# frontend 는 별도 호스팅 (Vercel) — image 에 포함 불필요
apps/frontend
